# ==============================================================================
# GitHub Intelligence Engine (2k+ Stars) — Environment Configuration Template
# Copy this file to .env and populate the required credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub API Authentication
# ------------------------------------------------------------------------------
# Required for telemetry ingestion and README context extraction.
# GitHub Personal Access Token (classic or fine-grained) with 'public_repo' read access.
# Unauthenticated requests are throttled at 60/hr; authenticated tokens allow 5,000/hr.
# Pipeline throttles deterministically to max 25 req/min to prevent secondary abuse flags.
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourGitHubPersonalAccessTokenHere

# ------------------------------------------------------------------------------
# 2. Dual Database Storage Configuration (Supabase or Turso)
# ------------------------------------------------------------------------------
# Active database backend provider. Must be either 'supabase' or 'turso'.
DB_PROVIDER=supabase

# Database Connection URL:
# - For Supabase (PostgreSQL with pgvector):
#   Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#   Obtain at: https://supabase.com/dashboard/project/_/settings/database
#
# - For Turso (LibSQL with native vector index):
#   Format: libsql://[YOUR-DATABASE-NAME]-[YOUR-ORG].turso.io
#   Obtain via Turso CLI: `turso db show --url <database-name>`
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Turso Authentication Token (Required ONLY when DB_PROVIDER is set to 'turso')
# Obtain via Turso CLI: `turso db tokens create <database-name>`
# Leave blank or omit if using Supabase.
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ------------------------------------------------------------------------------
# 3. Multi-Provider Free-Tier LLM Orchestration
# ------------------------------------------------------------------------------
# The categorization engine implements automatic failover across these free tiers.
# Order of fallback: Groq -> Gemini -> Cerebras -> OpenRouter.
# At least ONE LLM API key must be provided; configuring multiple ensures 99.99% uptime.

# Tier 1 (Primary): Groq Cloud (Model: llama-3.3-70b-versatile, 30 req/min free)
# Fast, low-latency structured JSON generation.
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=gsk_yourGroqApiKeyHere

# Tier 2 (Failover): Google AI Studio (Model: gemini-2.0-flash, 15 req/min free)
# Large context window fallback.
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Tier 3 (Failover): Cerebras Cloud (Model: llama-3.1-70b, 30 req/min free)
# High-throughput wafer-scale engine fallback.
# Obtain at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=csk-yourCerebrasApiKeyHere

# Tier 4 (Final Safety Net): OpenRouter Free Pool (Model: meta-llama/llama-3.3-70b-instruct:free)
# Community free-tier router failover.
# Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-yourOpenRouterApiKeyHere

# ------------------------------------------------------------------------------
# 4. Optional Pipeline Execution Tuning
# ------------------------------------------------------------------------------
# Batch limit for AI enrichment run (default: 1000)
BATCH_LIMIT=1000

# Minimum star threshold for telemetry ingestion (default: 2000)
MIN_STARS=2000
